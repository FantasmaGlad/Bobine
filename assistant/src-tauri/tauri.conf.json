{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bobine Assistant",
  "version": "0.1.0",
  "identifier": "com.bobine.assistant",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bobine — Assistant d'installation",
        "width": 1080,
        "height": 740,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#f8f9fa"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "FantasmaGlad",
    "copyright": "AGPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "Assistant d'installation Bobine",
    "longDescription": "Assistant graphique permettant de découvrir, configurer et déployer les bornes Bobine en SSH.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37"
        ],
        "section": "utils"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBQjNEMjc2ODdFN0Q4RDIKUldUUzJPZUhkdEt6K3RxWDlSTXVGQ2dBQy9HU0lQYnZlZDBnNk1tdVNnTkNDdEE0ekdtSUt3cTUK",
      "endpoints": [
        "https://github.com/FantasmaGlad/Bobine/releases/download/assistant-stable/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
