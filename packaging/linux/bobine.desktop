[Desktop Entry]
Type=Application
Name=Bobine
GenericName=Video and audio playout
GenericName[fr]=Régie vidéo et audio
Comment=Class playout, cinema kiosk and background radio for gyms and studios
Comment[fr]=Diffusion de cours, borne cinéma et radio d'ambiance pour salles de sport et studios
Exec=/usr/bin/bobine
Icon=com.bobine.app
Terminal=false
Categories=AudioVideo;Video;Player;
StartupNotify=true
X-GNOME-Autostart-enabled=true
Keywords=cinema;fitness;video;audio;kiosk;radio;gym;playout;
Keywords[fr]=cinéma;fitness;vidéo;audio;kiosque;radio;salle de sport;diffusion;
